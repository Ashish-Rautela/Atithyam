# Settings for the containers on AWS (no secrets here - those come from Secrets Manager).
# Edit, commit and push: the pipeline's Deploy stage applies them.
# Set elsewhere: DATABASE_URL, GEMINI_API_KEY, AUTHOR_HASH_SALT, RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET,
# RAZORPAY_WEBHOOK_SECRET, ADMIN_EMAILS (all in the AppSecret in Secrets Manager), BACKGROUND_SCRAPING
# (pipeline parameter), WORKER_MODE and HEADLESS (per container, see deploy.sh).

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Database: RDS PostgreSQL 16 + PostGIS, encrypted connection
DATABASE_SSL=require
DATABASE_POOL_MAX=10
AUTO_MIGRATE=true

# Worker
WORKER_CONCURRENCY=1
PARALLEL_PLATFORMS=true
SCHEDULER_EVERY_MIN=10
BROWSER_IDLE_CLOSE_SEC=60

# Data freshness and seeding
REFRESH_INTERVAL_DAYS=15
REFRESH_JITTER_HOURS=72
REFRESH_BATCH=25
REFRESH_MAX_REVIEWS=30
SEED_MAX_REVIEWS=30
NEIGHBOR_RADIUS_KM=5
ONBOARD_RADIUS_KM=3
DISCOVERY_FRESH_DAYS=90
CLUSTER_EPS_M=600
CLUSTER_MIN_POINTS=3
SEED_QUERIES=hotels,guest house,resort,homestay
SEED_TILE_RADIUS_KM=1.5

# AI analysis (Google Gemini) - the key itself is in Secrets Manager
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.8-flash
GEMINI_RPM=8
GEMINI_BATCH_SIZE=20
ANALYSIS_CONCURRENCY=1

# Scraping
MAX_REVIEWS_PER_PLATFORM=60
PAUSE_MIN_MS=1500
PAUSE_MAX_MS=4000
NAV_TIMEOUT_MS=45000
ENABLE_GOOGLE_MAPS=true
ENABLE_BOOKING=true
ENABLE_AGODA=true
ENABLE_MAKEMYTRIP=true
ENABLE_TRIPADVISOR=false

# Accounts (the site is served over HTTPS by CloudFront, so cookies are always Secure)
AUTH_REQUIRED=true
ALLOW_SIGNUP=true
COOKIE_SECURE=true
SESSION_DAYS=30
FREE_HOTEL_LIMIT=1

# Plan prices (rupees) and length (days); Razorpay keys are secrets
PLAN_PRO_PRICE_INR=999
PLAN_PRO_DAYS=30
PLAN_DESTINATION_PRICE_INR=4999
PLAN_DESTINATION_DAYS=30
