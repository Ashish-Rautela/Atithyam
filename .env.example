# Copy to server/.env and adjust. No secrets are required on a laptop.

# ---------------------------------------------------------------- API
PORT=4000
LOG_LEVEL=info

# ---------------------------------------------------------------- Database (Postgres 16 + PostGIS)
# Local: `npm run db:up` starts it in Docker with these credentials.
DATABASE_URL=postgres://rip:rip@localhost:5432/rip
# disable (local) | require (AWS RDS, encrypted) | verify (RDS + CA bundle in DATABASE_SSL_CA)
DATABASE_SSL=disable
# DATABASE_SSL_CA=/app/certs/ap-south-1-bundle.pem
DATABASE_POOL_MAX=10
# Apply migrations automatically when the API / worker starts
AUTO_MIGRATE=true
# Tests use a separate database (created by `npm run db:up`)
TEST_DATABASE_URL=postgres://rip:rip@localhost:5432/rip_test

# ---------------------------------------------------------------- Background worker
# embedded = the API also runs scraping jobs (laptop). off = run `npm run worker` separately (AWS).
WORKER_MODE=embedded
# Jobs at the same time. Keep 1 on one machine: every job uses Google Maps.
WORKER_CONCURRENCY=1
# Collect Agoda/Booking, MakeMyTrip (and Tripadvisor) at the same time once Google is read
PARALLEL_PLATFORMS=true
# How often each worker re-queues stuck jobs and queues due refreshes
SCHEDULER_EVERY_MIN=10
# false (laptop): the browser runs only for what you ask for — no automatic 15-day refreshes, no
# collecting every hotel around a new one, and scraping left queued from the last session is paused
# at start-up (it continues when you open that hotel's benchmark or press Resume on a city).
# true (AWS worker): refreshes and neighbourhood collection run on their own.
BACKGROUND_SCRAPING=false
# Close the browser window after this many idle seconds (0 = keep it open)
BROWSER_IDLE_CLOSE_SEC=60

# ---------------------------------------------------------------- Data freshness and seeding
# Every hotel is re-collected about every 15 days, each on its own date: ± REFRESH_JITTER_HOURS ("salt")
REFRESH_INTERVAL_DAYS=15
REFRESH_JITTER_HOURS=72
# Hotels queued per scheduler pass
REFRESH_BATCH=25
REFRESH_MAX_REVIEWS=30
# Reviews per platform when seeding a city or a new owner's neighbourhood
SEED_MAX_REVIEWS=30
# Nearby-hotel links are stored for hotels within this distance
NEIGHBOR_RADIUS_KM=5
# A new owner's neighbourhood: hotels within this distance are found and collected
ONBOARD_RADIUS_KM=3
# An area searched within this many days is not searched again for a new owner
DISCOVERY_FRESH_DAYS=90
# Micro-market clusters: hotels within CLUSTER_EPS_M chain together; at least CLUSTER_MIN_POINTS per cluster
CLUSTER_EPS_M=600
CLUSTER_MIN_POINTS=3
# Google Maps searches run on every map tile when seeding a city
SEED_QUERIES=hotels,guest house,resort,homestay
SEED_TILE_RADIUS_KM=1.5

# ---------------------------------------------------------------- AI analysis (Google Gemini)
# Aspect-sentiment on English / Hindi / Hinglish reviews and the written summaries.
# Without a key the app uses offline keyword rules (works, less accurate). Check with: npm run ai:check
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.8-flash
# Free tier is rate-limited: keep requests per minute low; reviews are sent in batches
GEMINI_RPM=8
GEMINI_BATCH_SIZE=20
ANALYSIS_CONCURRENCY=1

# ---------------------------------------------------------------- Scraping
# Visible browser window is recommended: sites challenge headless browsers far more often.
HEADLESS=false
MAX_REVIEWS_PER_PLATFORM=60
PAUSE_MIN_MS=1500
PAUSE_MAX_MS=4000
NAV_TIMEOUT_MS=45000
ENABLE_GOOGLE_MAPS=true
ENABLE_BOOKING=true
ENABLE_AGODA=true
ENABLE_MAKEMYTRIP=true
# Tripadvisor shows a CAPTCHA to automated browsers, so it is off by default.
ENABLE_TRIPADVISOR=false
# Salt used to pseudonymise reviewer names (reviewer names are never stored)
AUTHOR_HASH_SALT=change-me
